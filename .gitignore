# ---------------------------------------------------------------
# .gitignore — AdsDash / Graduation Project (BIS)
# What NOT to commit: Secrets, local data, build junk, editor cruft.
# ---------------------------------------------------------------

# Python Bytecode & Build Artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual Environments
venv/
.venv/
env/
.env.d/

# Secrets & Credentials (NEVER commit)
.env
.env.local
.env.*.local
!.env.example
credentials.json
credentials-*.json
config/credentials.json
config/credentials-*.json
!config/credentials.example.json
*.pem
*.p12
*.key

# Local Data & Databases
*.db
*.sqlite
*.sqlite3
data/*.db
data/*.sqlite
data/*.sqlite3
!data/.gitkeep
.streamlit/secrets.toml

# Uploaded Files & User Media
uploads/
static/uploads/

# Legacy, Scratch & Internal Test Directories
_old/
_Ex/
_test/
_report/
.write_test

# Agent & AI Tool Artifacts
.agents/

# Editors & OS Files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
