# ---------------------------------------------------------------
# .gitignore — AdsDash
# What NOT to commit. Secrets, local data, build junk, editor cruft.
# ---------------------------------------------------------------

# Python bytecode + build artefacts
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
venv/
.venv/
env/
.env.d/

# ---- SECRETS — never commit ----
# Env files (keep only the example).
.env
.env.local
.env.*.local
!.env.example

# Google service-account keys and other credentials.
credentials.json
credentials-*.json
config/credentials.json
config/credentials-*.json
!config/credentials.example.json
*.pem
*.p12
*.key

# ---- Local data / DB ----
*.db
*.sqlite
*.sqlite3
data/*.db
data/*.sqlite
data/*.sqlite3
!data/.gitkeep

# Streamlit
.streamlit/secrets.toml

# Editors / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Sandbox / testing scratch
.write_test
/_old
/venv
/venv

# Uploaded Files (Do NOT commit)
# Users can upload resumes, images, course materials, etc.
# These should be stored in the 'static' directory or similar, 
# but should never be part of the repository history.
uploads/
static/uploads/

.vscode/
.agents/
_old/
_Ex/
__pycache__/