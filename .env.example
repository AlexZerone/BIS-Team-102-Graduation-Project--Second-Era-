# Postgres connection string. Leave unset for local dev to use the embedded PGlite database in .data/pglite.
# DATABASE_URL=postgres://user:password@host:5432/second_era

# Where PGlite keeps its files when DATABASE_URL is unset (default .data/pglite).
# PGLITE_DIR=.data/pglite

# Private upload storage (resumes). Must not be inside public/. Default .data/uploads.
# STORAGE_DIR=.data/uploads

# --- Paymob (Egypt). Leave all unset to use simulated payments. ---
# Dashboard > Settings > Account Info: secret key, public key, HMAC secret.
# PAYMOB_SECRET_KEY=egy_sk_test_...
# PAYMOB_PUBLIC_KEY=egy_pk_test_...
# PAYMOB_HMAC_SECRET=...
# Dashboard > Developers > Payment Integrations: card / wallet integration IDs (test-mode IDs while testing).
# PAYMOB_INTEGRATION_IDS=1234567,7654321
# Public URL of this app; Paymob sends callbacks to $APP_URL/api/payments/paymob.
# APP_URL=https://your-domain.example
# PAYMOB_BASE_URL=https://accept.paymob.com
